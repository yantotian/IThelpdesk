# Copy this file to .env and edit the values before starting.
#   cp .env.example .env   (or: Copy-Item .env.example .env on Windows)

# REQUIRED: signs JWT/session and file-access tokens. Use a long random string:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Host port the app is published on
APP_PORT=8880

# Optional: domain served by Caddy. Leave as "localhost" for internal TLS,
# or set a public domain for Let's Encrypt (DNS must point at this server).
SITE_ADDRESS=localhost

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=helpdesk
ADMIN_USERNAME=admin
# Production rejects passwords shorter than 12 chars or equal to admin123
ADMIN_PASSWORD=change-me-admin-password